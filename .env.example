# Public browser config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-cloud-map-id

# Server-only Supabase/Postgres
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Server-only app secrets
ENCRYPTION_KEY=replace-with-a-long-random-secret
ADMIN_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
IP_HASH_PEPPER=replace-with-a-long-random-secret

# Server-side APIs
GOOGLE_MAPS_GEOCODING_API_KEY=your-server-geocoding-key
ANTHROPIC_API_KEY=your-anthropic-key
RESEND_API_KEY=your-resend-key

# Optional map layers
NEXT_PUBLIC_NDVI_TILE_URL=https://your-project.supabase.co/storage/v1/object/public/satellite-tiles/ndvi-bengaluru.png

# Optional Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional Gmail OAuth2 for email loop agent
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token
